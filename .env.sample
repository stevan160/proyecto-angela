# ============================================================================
# PROJECT ANGELA — Variables de Entorno
# ============================================================================
# Copia este archivo a .env y completa con tus valores reales

# ============================================================================
# 🔐 TWITCH — Bot de Twitch
# ============================================================================
# Obtén estos tokens desde https://dev.twitch.tv/console/apps
TWITCH_TOKEN=your_oauth_token_here
TWITCH_CHANNEL=your_channel_name
TWITCH_NICK=your_bot_username

# ============================================================================
# 🤖 OPENAI — Modelo GPT (fallback principal + preguntas complejas)
# ============================================================================
# Obtén tu API key en https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your_openai_api_key_here

# ============================================================================
# 🎤 ELEVENLABS — Text-to-Speech (voz de Angela)
# ============================================================================
# Obtén tu API key en https://elevenlabs.io/
# Modelos: eleven_multilingual_v1, eleven_multilingual_v2
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ============================================================================
# 🔌 VTUBESTUDIO — Control del avatar virtual
# ============================================================================
# El bot se conecta a VTube Studio via WebSocket en localhost:8001
# VTS_TOKEN se generará automáticamente en el primer run si no existe
# Pero puedes guardarlo aquí para evitar regenerarlo cada vez
VTS_TOKEN=your_vts_token_here

# ============================================================================
# 🧠 SERVIDOR IA LOCAL — Ollama + FastAPI
# ============================================================================
# IP/Host y puerto del servidor IA local (main.py se conecta aquí)
# En red local: 192.168.1.50:8000
# En localhost: localhost:8000 o 127.0.0.1:8000
IA_SERVER_HOST=192.168.1.50
IA_SERVER_PORT=8000
IA_SERVER_URL=http://192.168.1.50:8000

# Timeout en segundos para las solicitudes al servidor IA
IA_SERVER_TIMEOUT=30

# ============================================================================
# 📊 OLLAMA — Modelos locales de IA (requiere Ollama instalado)
# ============================================================================
# Los modelos se descargan automáticamente con: ollama pull <modelo>
# Modelos soportados: mixtral:8x7b, llama3.1:8b, llama3
# Configurable en server.py si quieres cambiar orden de preferencia
OLLAMA_HOST=localhost
OLLAMA_PORT=11434

# ============================================================================
# 📁 RUTAS Y ARCHIVOS
# ============================================================================
# Ruta del archivo de historial del servidor (se crea automáticamente)
HISTORY_FILE=angela_historial.json

# ============================================================================
# 🎮 JUEGOS — Shooter y Minecraft
# ============================================================================
# YOLO necesita acceso a GPU (CUDA). Configurable en game.py
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.5
